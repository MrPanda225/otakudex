# Copy to .env (git-ignored). Never commit real credentials.
#
# Postgres connection string. Pick one:
#   Neon (production):  postgres://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/otakudex?sslmode=require
#   Homelab (tests):    postgres://otakudex_app:PASSWORD@HOMELAB_HOST:5432/otakudex
#                       (add ?sslmode=require when the server has TLS: without it the link is not encrypted)
#   Embedded dev mode:  pglite://./.data/dev   (no server needed, data kept in ./.data)
DATABASE_URL=pglite://./.data/dev

# Optional: role allowed to change the schema, used only by `npm run migrate`.
# Falls back to DATABASE_URL when empty.
# MIGRATION_DATABASE_URL=

# The server listens on this machine only by default.
LISTEN_HOST=127.0.0.1
PORT=3000

# Set to true once the application is served over HTTPS (reverse proxy): the session cookie is then marked
# Secure. Required as soon as LISTEN_HOST is not 127.0.0.1, otherwise passwords travel unencrypted.
# COOKIE_SECURE=false

# Set to true only behind a reverse proxy that REWRITES the X-Forwarded-For header: the limit on sign-in attempts
# then counts each client's own address instead of the proxy's. Never set it when the application is reached directly.
# TRUST_PROXY=false

# Optional secret (8 characters or more) that whoever creates the first account must give. Set it before exposing
# a fresh server, otherwise the first visitor becomes the administrator. Not needed once the first account exists.
# SETUP_CODE=

# Optional: a service that translates the English synopses of Kitsu into French (docs/07). Without one, they stay in
# English. Set ONE of the two; DeepL wins when both are set. Each synopsis is translated once and kept in the database.
# DeepL API (a key ending in :fx is a free-plan key, 500,000 characters a month): https://www.deepl.com/pro-api
# DEEPL_API_KEY=
# LibreTranslate, for example a container on your own machine (no account, nothing leaves your network):
# LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_API_KEY=

# Time zone used to decide which calendar day an episode belongs to.
TIMEZONE=Europe/Paris

# Host names accepted in the Host header (DNS-rebinding protection).
# Add your LAN name or IP here if you open the app from your phone.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
