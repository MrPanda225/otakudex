{
  "name": "otakudex",
  "version": "0.1.0",
  "private": true,
  "description": "Personal anime ranking and tracking web app",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch-path=server --watch-path=shared server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/main.ts",
    "migrate": "node server/db/migrate-cli.ts",
    "admin:reset-link": "node server/auth/reset-cli.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test && npm audit --omit=dev",
    "backup": "bash scripts/backup.sh"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "animejs": "^4.5.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "preact": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
